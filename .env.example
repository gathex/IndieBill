DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth Secrets (generate with `openssl rand -base64 32`)
AUTH_SECRET=""

# Google OAuth 2.0 (Google Cloud Console Web Client Credentials)
# In Google Cloud Console, set Authorized redirect URI to:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Host trust for local development / custom deployment
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Optional integrations
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Mailtrap Email API
MAILTRAP_API_TOKEN=""
MAILTRAP_INBOX_ID="" # Optional: set sandbox inbox ID for testing; leave blank for Live sending
EMAIL_FROM="IndieBill <hello@indiebill.in>"
CRON_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
