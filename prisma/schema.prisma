generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  emailVerified   DateTime?
  image          String?
  passwordHash   String?
  businessName   String?
  businessAddress String?
  currency       String   @default("USD")
  country        String   @default("US")
  language       String   @default("en")
  logoDataUrl    String?
  qrName          String?
  qrVpa           String?
  qrUpiId         String?
  qrAccountNumber String?
  gstin           String?
  state           String?
  remindersEnabled Boolean  @default(true)
  remindBeforeDays Int      @default(3)
  remindOnDueDate  Boolean  @default(true)
  remindAfterDays  String   @default("3,7,14")
  plan             String   @default("FREE")
  isSuspended      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  clients    Client[]
  invoices   Invoice[]
  quotations Quotation[]
  payments   Payment[]
  catalogItems CatalogItem[]
  expenses   Expense[]
  recurringInvoices RecurringInvoice[]
  paymentReminderLogs PaymentReminderLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Client {
  id        String   @id @default(cuid())
  userId   String
  name     String
  email    String
  phone    String?
  company  String?
  notes      String?
  gstin      String?
  state      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  invoices   Invoice[]
  quotations Quotation[]
  recurringInvoices RecurringInvoice[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  number      String
  status      String   @default("DRAFT")
  issueDate   DateTime @default(now())
  dueDate     DateTime?
  subtotal    Float    @default(0)
  discountPercent Float @default(0)
  taxRate     Float    @default(0)
  tax         Float    @default(0)
  gstEnabled  Boolean  @default(false)
  taxType     String   @default("NONE")
  cgstAmount  Float    @default(0)
  sgstAmount  Float    @default(0)
  igstAmount  Float    @default(0)
  total       Float    @default(0)
  notes       String?
  paymentLink            String?
  razorpayPaymentLinkId  String?
  razorpayPaymentLinkUrl String?
  remindersPaused        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items       InvoiceItem[]
  quotations  Quotation[]
  payments    Payment[]
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  paymentReminderLogs PaymentReminderLog[]

  @@unique([userId, number])
  @@index([userId, clientId])
  @@index([recurringInvoiceId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId  String
  description String
  quantity   Float   @default(1)
  rate       Float   @default(0)
  amount     Float   @default(0)
  hsnSac     String?
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quotation {
  id                 String          @id @default(cuid())
  userId             String
  clientId           String
  number             String
  status             String          @default("DRAFT")
  issueDate          DateTime        @default(now())
  validUntil         DateTime?
  subtotal           Float           @default(0)
  discountPercent    Float           @default(0)
  taxRate            Float           @default(0)
  tax                Float           @default(0)
  gstEnabled         Boolean         @default(false)
  taxType            String          @default("NONE")
  cgstAmount         Float           @default(0)
  sgstAmount         Float           @default(0)
  igstAmount         Float           @default(0)
  total              Float           @default(0)
  notes              String?
  convertedInvoiceId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  convertedInvoice   Invoice?        @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  items              QuotationItem[]

  @@unique([userId, number])
  @@index([userId, clientId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Float     @default(1)
  rate        Float     @default(0)
  amount      Float     @default(0)
  hsnSac      String?
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  invoiceId   String
  amount      Float
  paymentDate DateTime @default(now())
  method      String   @default("MANUAL")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, reference])
  @@index([userId, paymentDate])
  @@index([userId, invoiceId])
}

model CatalogItem {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  rate           Float    @default(0)
  unit           String?
  hsnSac         String?
  defaultTaxRate Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, name])
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  title         String
  category      String
  amount        Float    @default(0)
  date          DateTime @default(now())
  vendor        String?
  paymentMethod String?
  taxAmount     Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
}

model RecurringInvoice {
  id              String                 @id @default(cuid())
  userId          String
  clientId        String
  title           String
  frequency       String                 // "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY"
  startDate       DateTime
  nextRunDate     DateTime
  endDate         DateTime?
  dueInDays       Int                    @default(15)
  autoSendEmail   Boolean                @default(false)
  status          String                 @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  currency        String?
  notes           String?
  discount        Float                  @default(0)
  taxRate         Float                  @default(0)
  gstEnabled      Boolean                @default(false)
  lastGeneratedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items             RecurringInvoiceItem[]
  generatedInvoices Invoice[]

  @@index([userId, status])
  @@index([userId, nextRunDate])
  @@index([status, nextRunDate])
}

model RecurringInvoiceItem {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  description        String
  quantity           Float            @default(1)
  rate               Float            @default(0)
  unit               String?
  hsnSac             String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

model PaymentReminderLog {
  id             String   @id @default(cuid())
  userId         String
  invoiceId      String
  type           String   // "BEFORE_DUE" | "ON_DUE" | "OVERDUE" | "MANUAL"
  channel        String   @default("EMAIL") // "EMAIL"
  recipientEmail String
  status         String   // "SENT" | "FAILED"
  errorMessage   String?
  sentAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([invoiceId, type])
}
